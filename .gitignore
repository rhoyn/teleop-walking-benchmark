.claude
build/
videos/
__pycache__/
policies/homie/model.onnx
policies/robomimic/model.pt
policies/robomimic/model.onnx
policies/run_residual/model_cmg.onnx
policies/run_residual/model_residual.onnx

# PyTorch checkpoints and other pickle-backed weights. The benchmark loads
# ONNX; these are the export inputs that download_weights.sh refetches.
*.pt
*.pth
*.ckpt
*.pkl
*.safetensors
*.bin

# sonic ships 825 MB of weights, over GitHub's 100 MB per-file limit
policies/sonic/*.onnx

# wcompton declares no licence upstream; NOTICE says fetch, do not commit
policies/wcompton/model.onnx

# bfm_zero's checkpoint is 123 MB, over GitHub's 100 MB per-file limit
policies/bfm_zero/model.onnx

# latents.bin is a CC BY-NC derivative too; *.bin above already holds it out
